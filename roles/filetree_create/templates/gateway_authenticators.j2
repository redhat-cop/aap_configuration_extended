{% import 'macros/yaml_value.j2' as yamlval %}
---
gateway_authenticators: {{ [] if current_gateway_authenticators_asset_value | length == 0 }}
{% for current_authenticator in current_gateway_authenticators_asset_value %}
{%   set _enabled = template_overrides_resources.gateway_authenticator[current_authenticator.name].enabled
                     | default(template_overrides_global.gateway_authenticator.enabled)
                     | default(current_authenticator.enabled) %}
{%   set _create_objects = template_overrides_resources.gateway_authenticator[current_authenticator.name].create_objects
                     | default(template_overrides_global.gateway_authenticator.create_objects)
                     | default(current_authenticator.create_objects) %}
{%   set _remove_users = template_overrides_resources.gateway_authenticator[current_authenticator.name].remove_users
                     | default(template_overrides_global.gateway_authenticator.remove_users)
                     | default(current_authenticator.remove_users) %}
{%   set _configuration = template_overrides_resources.gateway_authenticator[current_authenticator.name].configuration
                     | default(template_overrides_global.gateway_authenticator.configuration)
                     | default(current_authenticator.configuration) %}
{%   set _order = template_overrides_resources.gateway_authenticator[current_authenticator.name].order
                     | default(template_overrides_global.gateway_authenticator.order)
                     | default(current_authenticator.order) %}
  - name: "{{ template_overrides_resources.gateway_authenticator[current_authenticator.name].name
                     | default(template_overrides_global.gateway_authenticator.name)
                     | default(current_authenticator.name) }}"
    enabled: {{ yamlval.render_scalar(_enabled) }}
    create_objects: {{ yamlval.render_scalar(_create_objects) }}
    remove_users: {{ yamlval.render_scalar(_remove_users) }}
{%   if _configuration is mapping or (_configuration is sequence and _configuration is not string) %}
    configuration:
{{ _configuration | to_nice_yaml(indent=2, sort_keys=false) | indent(width=6, first=true) }}
{%   else %}
    configuration: {{ yamlval.render_scalar(_configuration) }}
{%   endif %}
    type: "{{ template_overrides_resources.gateway_authenticator[current_authenticator.name].type
                     | default(template_overrides_global.gateway_authenticator.type)
                     | default(current_authenticator.type) }}"
    order: {{ yamlval.render_scalar(_order) }}
{% endfor %}
...
