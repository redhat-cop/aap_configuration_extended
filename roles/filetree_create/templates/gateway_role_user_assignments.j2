{% from 'macros/assignment_target.j2' import resolve_target, check_inline_covered with context %}
{% set __empty_values = [None, '', "None", [], {}, [{}]] %}
{% set __emitted = namespace(entries=[]) %}
{% for current_role_user_assignment in current_gateway_role_user_assignments_asset_value
       if not ((current_role_user_assignment.summary_fields.role_definition.name | default('')) is match('^galaxy\\.')) %}
{%   set _override = template_overrides_resources.gateway_role_user_assignment[current_role_user_assignment.object_id] | default({}) %}
{%   set _sf = current_role_user_assignment.summary_fields | default({}) %}
{%   set _username = _override.username
        | default(template_overrides_global.gateway_role_user_assignment.username)
        | default(_sf.user.username | default(none)) %}
{%   set _role_definition = _override.role_definition
        | default(template_overrides_global.gateway_role_user_assignment.role_definition)
        | default(current_role_user_assignment.summary_fields.role_definition.name) %}
{%   if _username is none or _username in __empty_values %}
{{ undef(hint='Gateway role user assignment ' ~ (current_role_user_assignment.id | default('unknown')) ~ ' has no portable username (CaC requires names, not IDs)') | mandatory }}
{%   endif %}
{%   set _entry = namespace(value={'role_definition': _role_definition, 'user': _username}, skip=false) %}
{%   if _override.object_ids is defined %}
{%     set _entry.value = _entry.value | combine({'object_ids': _override.object_ids}) %}
{%   else %}
{%     set target = namespace(name=none, type=none, endpoint=none,
         content_type=none, organization=none, global_role=false,
         related_object_roles=none, inline_resource_type=none, inline_input_tags=[]) %}
{%     set _ = resolve_target(current_role_user_assignment, target) %}
{%     set _inline = namespace(covered=false) %}
{%     set _ = check_inline_covered(current_role_user_assignment, target, _username, 'user', _inline) %}
{%     if _inline.covered %}
{%       set _entry.skip = true %}
{%     elif organization_filter is defined and (organization_filter | length) > 0 and (
            target.global_role
            or (target.type == 'organizations' and target.name != organization_filter)
            or (target.organization not in [none, ''] and target.organization != organization_filter)
            or (target.organization in [none, ''] and target.type != 'organizations' and not target.global_role)
         ) %}
{# Org-specific export: drop platform-global roles (e.g. Platform Auditor) and out-of-org targets. #}
{%       set _entry.skip = true %}
{%     elif not target.global_role %}
{%       set _entry.value = _entry.value | combine({'object_ids': [target.name]}) %}
{%     endif %}
{%   endif %}
{%   if not _entry.skip %}
{%     set __emitted.entries = __emitted.entries + [_entry.value] %}
{%   endif %}
{% endfor %}
---
{% if __emitted.entries | length == 0 %}
gateway_role_user_assignments: []
{% else %}
gateway_role_user_assignments:
{%   for _item in __emitted.entries %}
  - role_definition: "{{ _item.role_definition }}"
{%     if _item.object_ids is defined %}
    object_ids:
{{ _item.object_ids | to_nice_yaml(indent=2, sort_keys=false) | indent(width=6, first=true) }}
{%     endif %}
    user: "{{ _item.user }}"
{%   endfor %}
{% endif %}
...
