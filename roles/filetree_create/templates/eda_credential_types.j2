{% import 'macros/jinja_safe_yaml.j2' as jinja_safe %}
---
eda_credential_types: {{ [] if current_eda_credential_types_asset_value | length == 0 }}
{% for __eda_credential_type in current_eda_credential_types_asset_value if not (__eda_credential_type['managed'] | default(false)) %}
{%   set __eda_resource = template_overrides_resources['eda_credential_type'][__eda_credential_type['name']] | default({}) %}
{%   set __eda_global = template_overrides_global['eda_credential_type'] | default({}) %}
  - name: "{{ __eda_credential_type['name'] }}"
    namespace: "{{ __eda_credential_type['namespace'] }}"
    description: "{{ __eda_resource['description']
                     | default(__eda_global['description'])
                     | default(__eda_credential_type['description']) }}"
    kind: "{{ __eda_credential_type['kind'] }}"
    inputs:
{{ __eda_resource['inputs']
   | default(__eda_credential_type['inputs']) | to_nice_yaml(indent=2,sort_keys=false) | indent(width=8, first=true) }}
{%   if __eda_resource['injectors'] is defined
      or (__eda_credential_type['injectors'] and __eda_credential_type['injectors'] != '---') %}
    injectors:
{%   set __injectors = __eda_resource['injectors']
                     | default(__eda_credential_type['injectors']) %}
{%   if __injectors is string %}
{%     set __injectors = __injectors | from_yaml %}
{%   endif %}
{{ jinja_safe.render_value(__injectors, 6) }}
{% else %}
    injectors: {}
{%   endif %}
{% endfor %}
...
