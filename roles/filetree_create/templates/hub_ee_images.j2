{% import 'macros/export_field.j2' as export %}
{% import 'macros/export_value.j2' as exportval %}
---
{% set __exportable_images = current_hub_ee_images_asset_value | selectattr('name', 'search', ':') | list %}
hub_ee_images: {{ [] if __exportable_images | length == 0 }}
{% set __excluded_fields = ['pulp_href', 'pulp_created', 'pulp_last_updated', 'digest'] %}
{% for current_ee_image in __exportable_images %}
{%   set ns = namespace(first=true) %}
{%   for __map_item in (current_ee_image | dict2items) if __map_item.key not in __excluded_fields %}
{%     if exportval.should_export_field(__map_item.key, __map_item.value, {}) | trim == 'true' %}
{%       if ns.first %}
  - {{ export.render(__map_item.key, __map_item.value, indent=0, first=true) }}
{%         set ns.first = false %}
{%       else %}
    {{ export.render(__map_item.key, __map_item.value, indent=0, first=true) }}
{%       endif %}
{%     endif %}
{%   endfor %}
{% endfor %}
