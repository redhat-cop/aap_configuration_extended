---
controller_execution_environments: {{ [] if current_execution_environments_asset_value | length == 0 }}
{% set __empty_values = [None, '', "None", [], {}, [{}]] %}
{% set __org_filter_active = organization_filter is defined and (organization_filter | length) > 0 %}
{% for ee in current_execution_environments_asset_value %}
{%   set __ee_has_org = ee.summary_fields.organization is defined and ee.summary_fields.organization.name is defined %}
{%   set __ee_org_matches = __ee_has_org and (ee.summary_fields.organization.name is match(organization_filter)) %}
{%   set __ee_is_global = not __ee_has_org %}
{%   set __ee_global_referenced = __ee_is_global and (ee.name in (referenced_global_ee_names | default([]))) %}
{%   if (not __org_filter_active) or __ee_org_matches or __ee_global_referenced or (include_all_lookvar_ees | default(false) | bool) %}
  - name: "{{ ee.name }}"
{%     if template_overrides_resources.ee[ee.name].description
                     | default(template_overrides_global.ee.description)
                     | default(ee.description) | regex_replace("'", "''") not in __empty_values %}
    description: |-
      {{ '{%- raw -%}' }}
      {{ template_overrides_resources.ee[ee.name].description
                     | default(template_overrides_global.ee.description)
                     | default(ee.description) | regex_replace("'", "''") | indent(6) }}
      {{ '{%- endraw -%}' }}
{%     endif %}
{%     if __ee_has_org %}
    organization: "{{ ee.summary_fields.organization.name }}"
{%     else %}
    organization:  # Leave this empty organization to let the object_diff role to work properly
{%     endif %}
    image: "{{ (template_overrides_resources.ee[ee.name].image
               | default(template_overrides_global.ee.image)
               | default(ee.image))
               | infra.aap_configuration_extended.filetree_as_var('controller_execution_environments', ee.name, 'image', (env_fields_as_variables | bool) and ('image' in env_fields_as_variables_map.controller_execution_environments), secrets_as_variables_prefix) }}"
    pull: "{{ template_overrides_resources.ee[ee.name].pull
              | default(template_overrides_global.ee.pull)
              | default(ee.pull) }}"
{%     if template_overrides_resources.ee[ee.name].credential is defined
      or template_overrides_global.ee.credential is defined
      or ee.summary_fields.credential is defined %}
    credential: "{{ template_overrides_resources.ee[ee.name].credential
                    | default(template_overrides_global.ee.credential)
                    | default(ee.summary_fields.credential.name) }}"
{%     endif %}
{%   endif %}
{% endfor %}
...
