{% import 'macros/yaml_value.j2' as yamlval %}
---
gateway_authenticator_maps: {{ [] if current_gateway_authenticator_maps_asset_value | length == 0 }}
{% for current_authenticator_map in current_gateway_authenticator_maps_asset_value %}
{%   set _revoke = template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].revoke
                     | default(template_overrides_global.gateway_authenticator_map.revoke)
                     | default(current_authenticator_map.revoke) %}
{%   set _triggers = template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].triggers
                     | default(template_overrides_global.gateway_authenticator_map.triggers)
                     | default(current_authenticator_map.triggers) %}
{%   set _order = template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].order
                     | default(template_overrides_global.gateway_authenticator_map.order)
                     | default(current_authenticator_map.order) %}
  - name: "{{ current_authenticator_map.name }}"
    authenticator: "{{ template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].authenticator
                     | default(template_overrides_global.gateway_authenticator_map.authenticator)
                     | default(current_authenticator_map.summary_fields.authenticator.name) }}"
    map_type: "{{ template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].map_type
                     | default(template_overrides_global.gateway_authenticator_map.map_type)
                     | default(current_authenticator_map.map_type) }}"
    role: "{{ template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].role
                     | default(template_overrides_global.gateway_authenticator_map.role)
                     | default(current_authenticator_map.role) }}"
    organization: "{{ template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].organization
                     | default(template_overrides_global.gateway_authenticator_map.organization)
                     | default(current_authenticator_map.organization) }}"
    team: "{{ template_overrides_resources.gateway_authenticator_map[current_authenticator_map.name].team
                     | default(template_overrides_global.gateway_authenticator_map.team)
                     | default(current_authenticator_map.team) }}"
    revoke: {{ yamlval.render_scalar(_revoke) }}
{%   if _triggers is mapping or (_triggers is sequence and _triggers is not string) %}
    triggers:
{{ _triggers | to_nice_yaml(indent=2, sort_keys=false) | indent(width=6, first=true) }}
{%   else %}
    triggers: {{ yamlval.render_scalar(_triggers) }}
{%   endif %}
    order: {{ yamlval.render_scalar(_order) }}
{% endfor %}
...
