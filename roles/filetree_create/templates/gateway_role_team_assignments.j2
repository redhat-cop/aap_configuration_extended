{% from 'macros/assignment_target.j2' import resolve_target, check_inline_covered with context %}
{% set __empty_values = [None, '', "None", [], {}, [{}]] %}
{% set __emitted = namespace(entries=[]) %}
{% for current_role_team_assignment in current_gateway_role_team_assignments_asset_value
       if not ((current_role_team_assignment.summary_fields.role_definition.name | default('')) is match('^galaxy\\.')) %}
{%   set _override = template_overrides_resources.gateway_role_team_assignment[current_role_team_assignment.object_id | default(current_role_team_assignment.id)] | default({}) %}
{%   set _sf = current_role_team_assignment.summary_fields | default({}) %}
{%   set _team_name = _override.team
        | default(template_overrides_global.gateway_role_team_assignment.team)
        | default(_sf.team.name | default(none)) %}
{%   set _team_ansible_id = _override.team_ansible_id
        | default(template_overrides_global.gateway_role_team_assignment.team_ansible_id)
        | default(current_role_team_assignment.team_ansible_id | default(none)) %}
{%   set _role_definition = _override.role_definition
        | default(template_overrides_global.gateway_role_team_assignment.role_definition)
        | default(current_role_team_assignment.summary_fields.role_definition.name) %}
{%   set _entry = namespace(value={'role_definition': _role_definition}, skip=false) %}
{%   if _team_name is not none and _team_name not in __empty_values %}
{%     set _entry.value = _entry.value | combine({'team': _team_name}) %}
{%   elif _team_ansible_id is not none and _team_ansible_id not in __empty_values %}
{%     set _entry.value = _entry.value | combine({'team_ansible_id': _team_ansible_id}) %}
{%   endif %}
{%   if _override.assignment_objects is defined %}
{%     set _entry.value = _entry.value | combine({'assignment_objects': _override.assignment_objects}) %}
{%   else %}
{%     set target = namespace(name=none, type=none, endpoint=none,
         content_type=none, organization=none, global_role=false,
         related_object_roles=none, inline_resource_type=none, inline_input_tags=[]) %}
{%     set _ = resolve_target(current_role_team_assignment, target) %}
{%     set _inline = namespace(covered=false) %}
{%     if _team_name is not none and _team_name not in __empty_values %}
{%       set _ = check_inline_covered(current_role_team_assignment, target, _team_name, 'team', _inline) %}
{%     endif %}
{%     if _inline.covered %}
{%       set _entry.skip = true %}
{%     elif not target.global_role %}
{%       set exported_object = {'name': target.name, 'type': target.type} %}
{%       if target.organization is not none
            and (target.type == 'teams'
                 or (target.type.startswith('awx.') and target.type not in
                     ['awx.executionenvironment', 'awx.instancegroup'])
                 or target.type.startswith('eda.')) %}
{%         set exported_object = exported_object | combine({'organization': target.organization}) %}
{%       endif %}
{%       set _entry.value = _entry.value | combine({'assignment_objects': [exported_object]}) %}
{%     endif %}
{%   endif %}
{%   if not _entry.skip %}
{%     set __emitted.entries = __emitted.entries + [_entry.value] %}
{%   endif %}
{% endfor %}
---
{% if __emitted.entries | length == 0 %}
gateway_role_team_assignments: []
{% else %}
gateway_role_team_assignments:
{%   for _item in __emitted.entries %}
  - role_definition: "{{ _item.role_definition }}"
{%     if _item.team is defined %}
    team: "{{ _item.team }}"
{%     elif _item.team_ansible_id is defined %}
    team_ansible_id: "{{ _item.team_ansible_id }}"
{%     endif %}
{%     if _item.assignment_objects is defined %}
    assignment_objects:
{{ _item.assignment_objects | to_nice_yaml(indent=2, sort_keys=false) | indent(width=6, first=true) }}
{%     endif %}
{%   endfor %}
{% endif %}
...
