---
# Copy to filetree_object_diff.yml and adjust paths for your environment.
#
#   cp examples/filetree_object_diff/vars/filetree_object_diff.yml.example \
#      examples/filetree_object_diff/vars/filetree_object_diff.yml
#
# Repository layout (same as filetree_read / filetree_create):
#   {{ dir_orgs_vars }}/{{ orgs }}/env/{{ env }}/
#   {{ dir_orgs_vars }}/{{ orgs }}/env/common/
#
orgs: "Default"
env: common
dir_orgs_vars: /srv/cac/orgs_vars

# Compare the whole organization subtree against the live export.
# Alternative: omit this variable and configure individual filetree_* paths
# (they are captured automatically on the first role run).
filetree_object_diff_config_dir: "{{ dir_orgs_vars }}/{{ orgs }}"

filetree_object_diff_live_path: /tmp/aap_live_export
filetree_object_diff_diff_path: /tmp/aap_cac_delta
filetree_object_diff_cleanup_live_path: true

# Render Jinja in repository CaC before comparison (orgs, env, secrets, etc.).
filetree_object_diff_template_vars:
  orgs: "{{ orgs }}"
  env: "{{ env }}"
  # vault_ansible_password: "{{ vault_ansible_password }}"

# Keys that differ between filetree_create export and hand-written CaC.
filetree_object_diff_ignore_keys:
  - description
  - notification_configuration
  - update_project
  - wait

controller_configuration_filetree_object_diff_secure_logging: true
controller_configuration_filetree_create_secure_logging: true
controller_configuration_filetree_read_secure_logging: true

# Limit which object types are compared and exported (omit types you do not manage).
controller_configuration_filetree_object_diff_tasks:
  - {name: controller_execution_environments, var: controller_execution_environments, tags: controller_execution_environments, create_tag: controller_execution_environments, object_type: execution_environment}
  - {name: controller_projects, var: controller_projects, tags: controller_projects, create_tag: controller_projects, object_type: project}
  - {name: controller_inventories, var: controller_inventories, tags: controller_inventories, create_tag: controller_inventories, object_type: inventory}
  - {name: controller_credentials, var: controller_credentials, tags: controller_credentials, create_tag: controller_credentials, object_type: credential}
  - {name: controller_teams, var: aap_teams, tags: controller_teams, create_tag: gateway_teams, object_type: team}
  - {name: controller_notification_templates, var: controller_notifications, tags: controller_notification_templates, create_tag: controller_notification_templates, object_type: notification_template}
  - {name: controller_hosts, var: controller_hosts, tags: controller_hosts, create_tag: controller_hosts, object_type: host}
  - {name: controller_inventory_sources, var: controller_inventory_sources, tags: controller_inventory_sources, create_tag: controller_inventory_sources, object_type: inventory_source}
  - {name: controller_job_templates, var: controller_templates, tags: controller_job_templates, create_tag: controller_job_templates, object_type: job_template}
  - {name: controller_workflow_job_templates, var: controller_workflows, tags: controller_workflow_job_templates, create_tag: controller_workflow_job_templates, object_type: workflow_job_template}
  - {name: controller_schedules, var: controller_schedules, tags: controller_schedules, create_tag: controller_schedules, object_type: schedule}

# Mapping from diff variables to infra.aap_configuration dispatch roles.
filetree_object_diff_dispatch_roles:
  - {var: controller_execution_environments, dispatch_role: controller_execution_environments, dispatch_tag: controller_execution_environments}
  - {var: controller_projects, dispatch_role: controller_projects, dispatch_tag: controller_projects}
  - {var: controller_inventories, dispatch_role: controller_inventories, dispatch_tag: controller_inventories}
  - {var: controller_credentials, dispatch_role: controller_credentials, dispatch_tag: controller_credentials}
  - {var: aap_teams, dispatch_role: gateway_teams, dispatch_tag: controller_teams}
  - {var: controller_notifications, dispatch_role: controller_notification_templates, dispatch_tag: controller_notification_templates}
  - {var: controller_hosts, dispatch_role: controller_hosts, dispatch_tag: controller_hosts}
  - {var: controller_inventory_sources, dispatch_role: controller_inventory_sources, dispatch_tag: controller_inventory_sources}
  - {var: controller_templates, dispatch_role: controller_job_templates, dispatch_tag: controller_job_templates}
  - {var: controller_workflows, dispatch_role: controller_workflow_job_templates, dispatch_tag: controller_workflow_job_templates}
  - {var: controller_schedules, dispatch_role: controller_schedules, dispatch_tag: controller_schedules}
