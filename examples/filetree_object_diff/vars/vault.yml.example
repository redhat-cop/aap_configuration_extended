---
# Copy and encrypt with ansible-vault:
#
#   cp examples/filetree_object_diff/vars/vault.yml.example \
#      examples/filetree_object_diff/vars/vault.yml
#   ansible-vault encrypt examples/filetree_object_diff/vars/vault.yml
#
# Pass to the playbook with -e @examples/filetree_object_diff/vars/vault.yml
#
aap_hostname: aap.example.com
aap_username: admin
aap_password: "changeme"
aap_validate_certs: false

# Optional secrets referenced from repository CaC (Jinja in YAML files).
# vault_ansible_password: "secret"
